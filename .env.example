# SQLAlchemy/Psycopg connection string used by the API and Alembic.
DATABASE_URL=postgresql+psycopg://spec_checker:change_me@127.0.0.1:5432/spec_checker

# Docker Compose. Copy this file to .env and replace the password.
POSTGRES_USER=spec_checker
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=spec_checker
APP_CONFIG_FILE=development.yaml
IMAGE_TAG=latest
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
# Maximum number of Base64 documents in one JSON API request.
API_MAX_DOCUMENTS_PER_JOB=10
MONKEYOCR_MODEL_PATH=/srv/specification-checker-models/huggingface
# Inference profile. Development defaults preserve the verified laptop mode.
MONKEYOCR_DTYPE=auto
MONKEYOCR_MAX_PIXELS=1003520
MONKEYOCR_MAX_NEW_TOKENS=
MONKEYOCR_PDF_RENDER_DPI=300
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_NAME=specification_checks
REDIS_BLOCK_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=10
WORKER_RECONNECT_DELAY_SECONDS=2
WORKER_JOB_TIMEOUT_SECONDS=3600
WORKER_LOCK_TTL_SECONDS=120
EXPECTED_WORKER_COUNT=2
JOB_STORAGE_ROOT=runtime/jobs
JOB_CLEANUP_ENABLED=true
JOB_RETENTION_DAYS=30
JOB_CLEANUP_INTERVAL_SECONDS=3600
JOB_CLEANUP_BATCH_SIZE=100

# Optional isolated 1C adapter. Keep disabled until callback delivery is wanted.
ONEC_INTEGRATION_ENABLED=false
ONEC_ADAPTER=mock
ONEC_API_URL=
ONEC_AUTH_TOKEN=
ONEC_AUTH_USERNAME=
ONEC_AUTH_PASSWORD=
ONEC_TIMEOUT_SECONDS=15
ONEC_MAX_DELIVERY_ATTEMPTS=3
ONEC_MOCK_OUTBOX_DIR=runtime/onec/mock_outbox

# Optional API settings.
SPECIFICATION_CHECKER_HOST=0.0.0.0
SPECIFICATION_CHECKER_PORT=8000
# SPECIFICATION_CHECKER_CONFIG=/srv/specification-checker/config/production.yaml
