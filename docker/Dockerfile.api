FROM python:3.12-slim-bookworm

ARG APP_VERSION=dev
ARG VCS_REF=unavailable
LABEL org.opencontainers.image.title="Specification Checker API" \
      org.opencontainers.image.version=$APP_VERSION \
      org.opencontainers.image.revision=$VCS_REF

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home app

WORKDIR /app
COPY requirements-api.txt pyproject.toml README.md ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-api.txt

COPY app ./app
COPY config ./config
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini
RUN python -m pip install --no-deps . \
    && mkdir -p /runtime/jobs \
    && chown -R app:app /runtime /app

USER app
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
